# Copy to .env and fill in. Never commit the real .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Database (docker-compose)
POSTGRES_PASSWORD=change-me-owner-password
DENITRACK_APP_PASSWORD=change-me-app-password

# --- API
DENITRACK_ENVIRONMENT=production
DENITRACK_JWT_SECRET=change-me-to-a-long-random-string
DENITRACK_ACCESS_TOKEN_MINUTES=15
DENITRACK_REFRESH_TOKEN_DAYS=30
DENITRACK_LOGIN_RATE_LIMIT_PER_MINUTE=5
# DENITRACK_CORS_ORIGINS=["https://admin.example.co.ke"]

# --- SMS reminders: mock | sandbox | production  (Africa's Talking)
DENITRACK_SMS_MODE=mock
DENITRACK_SMS_USERNAME=
DENITRACK_SMS_API_KEY=
DENITRACK_SMS_SENDER_ID=

# --- Push notifications: only "mock" is implemented in this release
DENITRACK_PUSH_MODE=mock

# --- M-Pesa (Safaricom Daraja): mock | sandbox | production
DENITRACK_MPESA_MODE=mock
DENITRACK_MPESA_CONSUMER_KEY=
DENITRACK_MPESA_CONSUMER_SECRET=
DENITRACK_MPESA_SHORTCODE=
DENITRACK_MPESA_PASSKEY=
# Public HTTPS base URL Daraja can reach, e.g. https://api.example.co.ke
DENITRACK_MPESA_CALLBACK_BASE_URL=
# Long random value; becomes part of the callback URL
DENITRACK_MPESA_CALLBACK_TOKEN=change-me-random-callback-token
