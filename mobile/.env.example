# Copy to mobile/.env. Values prefixed EXPO_PUBLIC_ are compiled into the app and are
# therefore NOT secret: never put API keys, database or M-Pesa credentials here.

# Android emulator -> backend on this computer:
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# Physical phone on the same Wi-Fi: http://<your-computer-LAN-IP>:8000
# Release builds must use HTTPS, e.g. https://api.example.co.ke
